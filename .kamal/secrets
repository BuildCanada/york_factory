# Secrets pulled from Rails credentials (config/credentials.yml.enc).
# Requires config/master.key to exist locally. Never check master.key into git!
# See config/credentials.yml.sample for the expected structure.
#
# Populate credentials with: bin/rails credentials:edit

RAILS_MASTER_KEY=$(cat config/master.key)

# Durable image registry. The PAT needs read:packages and write:packages.
KAMAL_REGISTRY_PASSWORD=$(bin/rails credentials:fetch kamal.registry_password)

# Database — configured via database.yml reading from credentials, no env var needed

# LLM
ANTHROPIC_API_KEY=$(bin/rails credentials:fetch llm.anthropic_api_key)

# Search
TURBOPUFFER_API_KEY=$(bin/rails credentials:fetch search.turbopuffer.production_api_key)

# R2
R2_ACCESS_KEY_ID=$(bin/rails credentials:fetch r2.access_key_id)
R2_SECRET_ACCESS_KEY=$(bin/rails credentials:fetch r2.secret_access_key)
R2_ENDPOINT=$(bin/rails credentials:fetch r2.endpoint)
R2_BUCKET=$(bin/rails credentials:fetch r2.bucket)
R2_ACTIVE_STORAGE_BUCKET=$(bin/rails credentials:fetch r2.active_storage_bucket)

# SSL — Cloudflare Origin Certificate
CERTIFICATE_PEM=$(bin/rails credentials:fetch ssl.certificate_pem)
PRIVATE_KEY_PEM=$(bin/rails credentials:fetch ssl.private_key_pem)
