# syntax=docker/dockerfile:1
# Dev image for local docker-compose. Runs Rails in development mode, so no
# RAILS_MASTER_KEY or encrypted credentials are required. Source is bind-mounted
# at runtime; the bundle lives in a named volume so installed gems survive
# container restarts.

ARG RUBY_VERSION=4.0.2
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# Runtime + build deps in a single stage (no separate prod build stage needed
# for a dev image). Superset of what the prod Dockerfile installs across its
# base+build stages.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
        build-essential \
        curl \
        git \
        libgeos-dev \
        libjemalloc2 \
        libpq-dev \
        libproj-dev \
        libvips \
        libyaml-dev \
        pkg-config \
        postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV RAILS_ENV=development \
    BUNDLE_PATH=/usr/local/bundle

# Install gems (including the `development` group, which the prod Dockerfile
# excludes via BUNDLE_WITHOUT=development).
COPY Gemfile Gemfile.lock ./
COPY vendor/ ./vendor/
RUN bundle install

# Source is bind-mounted at runtime; this COPY is just so the image is
# runnable standalone (e.g. `docker run` without compose).
COPY . .

EXPOSE 3000

# CMD must end in exactly `./bin/rails server` for bin/docker-entrypoint to
# trigger `db:prepare`. Pass binding/port through env vars (BINDING, PORT)
# from compose instead of CLI flags.
ENTRYPOINT ["/rails/bin/docker-entrypoint"]
CMD ["./bin/rails", "server"]
