<%= form_with(model: [:admin, builder], class: "card") do |f| %>
  <% if builder.errors.any? %>
    <div class="flash flash-alert">
      <% builder.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <%= render "admin/shared/translated_text_field", form: f, field: :title %>
  <%= render "admin/shared/slug_field", form: f %>
  <%= render "admin/shared/translated_text_field", form: f, field: :byline %>
  <%= render "admin/shared/translated_text_field", form: f, field: :quote, input_type: :text_area %>
  <%= render "admin/shared/translated_rich_text", form: f, field: :body, retranslate_url: builder.persisted? ? retranslate_admin_builder_path(builder) : nil %>
  <%= render "admin/shared/translated_rich_text", form: f, field: :author, retranslate_url: builder.persisted? ? retranslate_admin_builder_path(builder) : nil %>

  <%= render "admin/shared/file_upload", form: f, field: :image %>
  <%= render "admin/shared/publish_fields", form: f %>

  <div class="btn-group mt-1">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <a href="<%= builder.persisted? ? admin_builder_path(builder) : admin_builders_path %>" class="btn">Cancel</a>
  </div>
<% end %>
