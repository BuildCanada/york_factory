<div class="page-header">
  <h1>Critiques</h1>
  <span class="text-muted">
    Pending: <strong><%= @counts.fetch(Critique.statuses[:pending], 0) %></strong> &middot;
    Approved: <strong><%= @counts.fetch(Critique.statuses[:approved], 0) %></strong> &middot;
    Rejected: <strong><%= @counts.fetch(Critique.statuses[:rejected], 0) %></strong>
  </span>
</div>

<%= form_with url: admin_critiques_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <%= f.label :status, "Status" %>
  <%= f.select :status,
        [ [ "All", "" ], [ "Pending", "pending" ], [ "Approved", "approved" ], [ "Rejected", "rejected" ] ],
        { selected: @status_filter },
        class: "form-control", onchange: "this.form.submit()" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Memo</th>
      <th>Author</th>
      <th>Body</th>
      <th>Status</th>
      <th>Submitted</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @critiques.each do |critique| %>
      <tr>
        <td><%= critique.memo&.title_en || "—" %></td>
        <td>
          <div><%= critique.name %></div>
          <div class="text-muted mono" style="font-size: 0.7rem;"><%= critique.email %></div>
        </td>
        <td style="max-width: 360px;"><%= truncate(critique.body, length: 160) %></td>
        <td>
          <% color = { "pending" => "yellow", "approved" => "green", "rejected" => "red" }[critique.status] %>
          <span class="badge badge-<%= color %>"><%= critique.status.capitalize %></span>
        </td>
        <td class="text-muted"><%= critique.created_at.strftime("%b %d, %Y") %></td>
        <td class="text-right"><a href="<%= admin_critique_path(critique) %>" class="btn btn-sm">Review</a></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "admin/shared/pagination", pagy: @pagy %>
