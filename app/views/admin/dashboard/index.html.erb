<% if flash[:notice] %>
  <div class="flash flash-notice"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="flash flash-alert"><%= flash[:alert] %></div>
<% end %>

<h1>Dashboard</h1>

<h2>Record Counts</h2>
<div class="grid">
  <% @counts.each do |label, count| %>
    <div class="card">
      <div class="label"><%= label.to_s.titleize %></div>
      <div class="value"><%= number_with_delimiter(count) %></div>
    </div>
  <% end %>
</div>

<h2>Data Sources</h2>

<div style="margin-bottom: 1rem;">
  <%= form_tag admin_trigger_ingest_all_path, method: :post, style: "display:inline" do %>
    <button type="submit" class="btn btn-accent" onclick="return confirm('This will queue all data sources for background ingestion. Continue?')">
      Ingest All Sources
    </button>
  <% end %>
</div>

<% if @sources.any? %>
  <table>
    <thead>
      <tr>
        <th>Source</th>
        <th>Format</th>
        <th>Last Fetched</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @sources.each do |source| %>
        <tr>
          <td>
            <strong><%= source[:name] %></strong>
            <div class="text-muted mono" style="font-size: 0.7rem; margin-top: 2px;"><%= truncate(source[:url], length: 50) %></div>
          </td>
          <td><span class="badge badge-blue"><%= source[:format] %></span></td>
          <td>
            <% if source[:last_fetched_at] %>
              <%= time_ago_in_words(source[:last_fetched_at]) %> ago
            <% else %>
              <span class="text-muted">Never</span>
            <% end %>
          </td>
          <td>
            <% if source[:latest_ingestion] %>
              <span class="badge badge-<%= source[:latest_ingestion][:status] == 'complete' ? 'green' : source[:latest_ingestion][:status] == 'failed' ? 'red' : 'yellow' %>">
                <%= source[:latest_ingestion][:status] %>
              </span>
            <% else %>
              <span class="text-muted">-</span>
            <% end %>
          </td>
          <td>
            <% if source[:ingestable] %>
              <%= form_tag admin_trigger_ingest_path(source_name: source[:name]), method: :post, style: "display:inline" do %>
                <button type="submit" class="btn btn-sm">Run</button>
              <% end %>
            <% else %>
              <span class="text-muted">-</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty">No sources configured. Run <code>bin/rails db:seed</code>.</div>
<% end %>

<% if @low_confidence_count > 0 %>
  <h2>Attention Required</h2>
  <div class="card" style="border-color: var(--yellow); margin-bottom: 2rem;">
    <div class="label">Low Confidence Matches</div>
    <div class="value" style="color: var(--yellow);"><%= @low_confidence_count %></div>
    <a href="/admin/lineage_review" style="font-size: 0.85rem;">Review &rarr;</a>
  </div>
<% end %>

<% if @anomalies.any? %>
  <h2>Recent Anomalies</h2>
  <table>
    <thead>
      <tr>
        <th>Government Entity</th>
        <th>Fiscal Year</th>
        <th class="text-right">Variance</th>
      </tr>
    </thead>
    <tbody>
      <% @anomalies.each do |a| %>
        <tr>
          <td><%= a[:government_entity] %></td>
          <td class="mono"><%= a[:fiscal_year] %></td>
          <td class="text-right">
            <span class="badge badge-red"><%= a[:variance_pct] %>%</span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
