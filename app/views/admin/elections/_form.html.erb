<%= form_with model: election, url: election.persisted? ? admin_election_path(election) : admin_elections_path,
      scope: :warehouse_election, class: "card" do |f| %>
  <% if election.errors.any? %>
    <div class="flash flash-alert">
      <% election.errors.full_messages.each do |msg| %><div><%= msg %></div><% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: "form-control", placeholder: "Ottawa 2026 General Municipal Election" %>
  </div>

  <div class="form-group">
    <%= f.label :slug %>
    <%= f.text_field :slug, class: "form-control", placeholder: "ottawa-2026" %>
    <div class="text-muted" style="font-size:0.8rem;">
      Used in the public API path (<code>/api/v1/elections/&lt;slug&gt;</code>). Convention: <code>city-year</code>.
    </div>
  </div>

  <div class="form-group">
    <%= f.label :kind %>
    <%= f.select :kind, Warehouse::Election.kinds.keys.map { |k| [ k.titleize, k ] }, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :jurisdiction_id, "Jurisdiction" %>
    <%= f.collection_select :jurisdiction_id,
          Warehouse::Jurisdiction.order(:name), :id, :name,
          { include_blank: "— none —" }, class: "form-control" %>
  </div>

  <fieldset style="border:1px solid var(--border, #ddd); padding:0.75rem; margin-bottom:1rem;">
    <legend class="text-muted" style="font-size:0.8rem;">Or create a new jurisdiction</legend>
    <p class="text-muted" style="font-size:0.8rem; margin-top:0;">
      Fill in a name to create a jurisdiction and use it instead of the dropdown above.
    </p>
    <div class="form-group">
      <%= label_tag "new_jurisdiction[name]", "Name" %>
      <%= text_field_tag "new_jurisdiction[name]", nil, class: "form-control", placeholder: "City of Ottawa" %>
    </div>
    <div class="form-group">
      <%= label_tag "new_jurisdiction[slug]", "Slug" %>
      <%= text_field_tag "new_jurisdiction[slug]", nil, class: "form-control", placeholder: "ottawa (defaults to the name, parameterized)" %>
    </div>
    <div class="form-group">
      <%= label_tag "new_jurisdiction[code]", "Code" %>
      <%= text_field_tag "new_jurisdiction[code]", nil, class: "form-control", placeholder: "OTT-ON" %>
    </div>
    <div class="form-group">
      <%= label_tag "new_jurisdiction[level]", "Level" %>
      <%= select_tag "new_jurisdiction[level]",
            options_for_select(Warehouse::Jurisdiction.levels.keys.map { |l| [ l.titleize, l ] }, "municipal"),
            class: "form-control" %>
    </div>
  </fieldset>

  <div class="form-group">
    <%= f.label :election_date, "Election day" %>
    <%= f.date_field :election_date, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :nomination_close_date, "Nominations close" %>
    <%= f.date_field :nomination_close_date, class: "form-control" %>
  </div>

  <div class="btn-group mt-1">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <a href="<%= election.persisted? ? admin_election_path(election) : admin_elections_path %>" class="btn">Cancel</a>
  </div>
<% end %>
