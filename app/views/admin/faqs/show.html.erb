<div class="page-header">
  <h1>FAQ</h1>
  <div class="btn-group">
    <a href="<%= edit_admin_faq_path(@faq) %>" class="btn btn-sm">Edit</a>
    <%= link_to "Delete", admin_faq_path(@faq), data: { turbo_method: :delete, turbo_confirm: "Delete this FAQ?" }, class: "btn btn-sm btn-danger" %>
  </div>
</div>

<div class="card mb-2">
  <p><strong>Question (EN):</strong> <%= @faq.question_en %></p>
  <div><strong>Answer (EN):</strong></div>
  <div class="rendered-markdown"><%= render_markdown @faq.answer_en %></div>
  <p><strong>Position:</strong> <%= @faq.position %></p>
  <p><strong>Status:</strong>
    <span class="badge badge-<%= { 'published' => 'green', 'draft' => 'yellow', 'scheduled' => 'blue' }[@faq.publish_status] %>">
      <%= @faq.publish_status.capitalize %>
    </span>
  </p>
  <% if @faq.link_href.present? %>
    <p><strong>Link:</strong> <a href="<%= @faq.link_href %>"><%= @faq.link_text || @faq.link_href %></a></p>
  <% end %>
</div>
