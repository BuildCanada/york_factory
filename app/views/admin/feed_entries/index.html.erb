<div class="page-header">
  <h1>Feed Entries</h1>
</div>

<table>
  <thead>
    <tr>
      <th>Type</th>
      <th>Title</th>
      <th>Published</th>
      <th>Featured</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @feed_entries.each do |entry| %>
      <tr>
        <td>
          <span class="badge"><%= entry.feedable_type.demodulize %></span>
        </td>
        <td><%= entry.feedable.try(:title) || entry.feedable.try(:body)&.truncate(60) || "—" %></td>
        <td class="text-muted"><%= entry.published_at&.strftime("%b %d, %Y %H:%M") %></td>
        <td>
          <% if entry.featured? %><span class="badge badge-blue">Featured</span><% end %>
        </td>
        <td class="text-right">
          <a href="<%= edit_admin_feed_entry_path(entry) %>" class="btn btn-sm">Edit</a>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "admin/shared/pagination", pagy: @pagy %>
