<%= form_with(model: [:admin, feed_item], class: "card") do |f| %>
  <% if feed_item.errors.any? %>
    <div class="flash flash-alert">
      <% feed_item.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="form-group">
    <label>Item Type</label>
    <%= f.select :item_type, FeedItem::ITEM_TYPES.map { |t| [t.upcase, t] }, {}, class: "form-control" %>
  </div>

  <%= render "admin/shared/translated_text_field", form: f, field: :title %>
  <%= render "admin/shared/translated_text_field", form: f, field: :subtitle %>
  <%= render "admin/shared/translated_rich_text", form: f, field: :body, retranslate_url: feed_item.persisted? ? retranslate_admin_feed_item_path(feed_item) : nil %>

  <div class="form-group">
    <label>Author</label>
    <%= f.text_field :author, class: "form-control" %>
  </div>

  <div class="form-group">
    <label>Source URL</label>
    <%= f.text_field :source_url, class: "form-control" %>
  </div>

  <div class="form-group">
    <label>URL</label>
    <%= f.text_field :url, class: "form-control" %>
  </div>

  <div class="form-group">
    <label>Embed Code</label>
    <%= f.text_area :embed_code, class: "form-control", rows: 3 %>
  </div>

  <div class="form-group">
    <label>Tags (comma-separated)</label>
    <%= f.text_field :tags, value: feed_item.tags&.join(", "), class: "form-control" %>
  </div>

  <div class="form-group">
    <label><%= f.check_box :featured %> Featured</label>
  </div>

  <%= render "admin/shared/file_upload", form: f, field: :image %>
  <%= render "admin/shared/file_upload", form: f, field: :author_photo, label: "Author Photo" %>
  <%= render "admin/shared/publish_fields", form: f %>

  <div class="btn-group mt-1">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <a href="<%= feed_item.persisted? ? admin_feed_item_path(feed_item) : admin_feed_items_path %>" class="btn">Cancel</a>
  </div>
<% end %>
