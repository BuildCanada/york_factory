<div class="page-header">
  <h1>Memos</h1>
  <a href="<%= new_admin_memo_path %>" class="btn btn-primary">New Memo</a>
</div>

<%= form_with url: admin_memos_path, method: :get, local: true, class: "filter-bar" do |f| %>
  <%= f.label :publication, "Publication" %>
  <%= f.select :publication,
        [["All", ""], ["Build Canada only", "none"]] + Memo::PUBLICATIONS.map { |p| [p.titleize, p] },
        { selected: @publication_filter },
        class: "form-control", onchange: "this.form.submit()" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Publication</th>
      <th>Category</th>
      <th>Status</th>
      <th>Published</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @memos.each do |memo| %>
      <tr>
        <td><a href="<%= admin_memo_path(memo) %>"><%= memo.title_en || "Untitled" %></a></td>
        <td><%= memo.publication.present? ? memo.publication.titleize : "Build Canada" %></td>
        <td><%= memo.category %></td>
        <td>
          <span class="badge badge-<%= { 'published' => 'green', 'draft' => 'yellow', 'scheduled' => 'blue' }[memo.publish_status] %>">
            <%= memo.publish_status.capitalize %>
          </span>
          <% if memo.featured? %><span class="badge badge-blue">Featured</span><% end %>
        </td>
        <td class="text-muted"><%= memo.published_at&.strftime("%b %d, %Y") || "—" %></td>
        <td class="text-right"><a href="<%= edit_admin_memo_path(memo) %>" class="btn btn-sm">Edit</a></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "admin/shared/pagination", pagy: @pagy %>
