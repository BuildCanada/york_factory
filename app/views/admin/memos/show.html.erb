<div class="page-header">
  <h1><%= @memo.title_en || "Untitled" %></h1>
  <div class="btn-group">
    <% if !@memo.published? %>
      <a href="<%= preview_url("/memos/#{@memo.slug}") %>" target="_blank" class="btn btn-sm">Preview</a>
    <% end %>
    <a href="<%= edit_admin_memo_path(@memo) %>" class="btn btn-sm">Edit</a>
    <%= link_to "Delete", admin_memo_path(@memo), data: { turbo_method: :delete, turbo_confirm: "Delete this memo?" }, class: "btn btn-sm btn-danger" %>
  </div>
</div>

<div class="card mb-2">
  <p><strong>Slug:</strong> <%= render "admin/shared/slug_with_history", record: @memo %></p>
  <p><strong>Category:</strong> <%= @memo.category || "—" %></p>
  <p><strong>Author:</strong> <%= @memo.author&.name || @memo.author_name || "—" %></p>
  <p><strong>Status:</strong>
    <span class="badge badge-<%= { 'published' => 'green', 'draft' => 'yellow', 'scheduled' => 'blue' }[@memo.publish_status] %>">
      <%= @memo.publish_status.capitalize %>
    </span>
  </p>
  <p><strong>Published at:</strong> <%= @memo.published_at&.strftime("%b %d, %Y %H:%M") || "—" %></p>
  <% if @memo.banner_image.attached? %>
    <p><strong>Banner Image:</strong></p>
    <%= image_tag url_for(@memo.banner_image), class: "file-preview" %>
  <% end %>
  <% if @memo.seo_image.attached? %>
    <p><strong>SEO Image:</strong></p>
    <%= image_tag url_for(@memo.seo_image), class: "file-preview" %>
  <% end %>
</div>

<% if @memo.key_messages_en.present? %>
  <div class="card mb-2">
    <h2>Key Messages</h2>
    <ul>
      <% @memo.key_messages_en.each do |msg| %>
        <li><%= msg.is_a?(Hash) ? msg["message"] : msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @memo.supporters_en.present? %>
  <div class="card mb-2">
    <h2>Supporters (EN)</h2>
    <div class="rendered-markdown"><%= render_markdown @memo.supporters_en %></div>
  </div>
<% end %>

<div class="card mb-2">
  <h2>Body (EN)</h2>
  <div class="rendered-markdown"><%= render_markdown @memo.body_en %></div>
</div>

<% if @memo.appendix_en.present? %>
  <div class="card">
    <h2>Appendix (EN)</h2>
    <div class="rendered-markdown"><%= render_markdown @memo.appendix_en %></div>
  </div>
<% end %>

<% if @memo.poll? %>
  <div class="card mt-1">
    <h2>Poll publication</h2>
    <p>Survey: <%= @memo.survey_slug %> · Campaign: <%= @memo.survey_campaign_id %></p>
    <% PollPublication::DOWNLOADS.each do |name| %>
      <% if @memo.public_send(name).attached? %>
        <p><%= link_to name.humanize, url_for(@memo.public_send(name)) %></p>
      <% end %>
    <% end %>
    <% %i[methodology news_release subscriber_email].each do |field| %>
      <h3><%= field.to_s.humanize %> (EN)</h3>
      <div class="rendered-markdown"><%= render_markdown @memo.public_send("#{field}_en") %></div>
    <% end %>
    <p><strong>Email subject:</strong> <%= @memo.email_subject_en %></p>
    <p><strong>Tweet:</strong> <%= @memo.tweet_en %></p>
  </div>
<% end %>
