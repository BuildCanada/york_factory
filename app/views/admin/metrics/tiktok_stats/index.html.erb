<div class="page-header">
  <h1>TikTok Stats</h1>
</div>

<div class="card" style="margin-bottom: 2rem; padding: 1.25rem;">
  <h2>Import CSV or ZIP</h2>
  <%= form_tag import_admin_metrics_tiktok_stats_path, multipart: true, style: "display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;" do %>
    <div class="form-group" style="margin-bottom: 0;">
      <label for="account">Account</label>
      <select name="account" id="account" class="form-control" style="width: 200px;">
        <option value="">Select account...</option>
        <% Metrics::TiktokStat::ACCOUNTS.each do |acct| %>
          <option value="<%= acct %>" <%= "selected" if acct == @account %>><%= acct.titleize %></option>
        <% end %>
      </select>
    </div>
    <div class="form-group" style="margin-bottom: 0;">
      <label for="file">CSV or ZIP File</label>
      <input type="file" name="file" id="file" accept=".csv,.zip" class="form-control" style="width: 300px;">
    </div>
    <div class="form-group" style="margin-bottom: 0;">
      <label for="start_year">Start Year <span class="text-muted" style="font-size: 0.75rem;">(optional)</span></label>
      <input type="number" name="start_year" id="start_year" placeholder="auto from filename" class="form-control" style="width: 160px;">
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
  <% end %>
  <p class="text-muted" style="font-size: 0.8rem; margin-top: 0.75rem;">
    TikTok's Overview export omits the year from dates. Start year is auto-detected from the zip filename (e.g. <code>Overview_2025-04-23_...</code>); override above if needed.
  </p>
</div>

<div style="margin-bottom: 1rem; display: flex; gap: 0.5rem;">
  <a href="<%= admin_metrics_tiktok_stats_path %>" class="btn btn-sm <%= 'btn-primary' if @account.blank? %>">All</a>
  <% Metrics::TiktokStat::ACCOUNTS.each do |acct| %>
    <a href="<%= admin_metrics_tiktok_stats_path(account: acct) %>" class="btn btn-sm <%= 'btn-primary' if @account == acct %>"><%= acct.titleize %></a>
  <% end %>
</div>

<% if @stats.any? %>
  <table>
    <thead>
      <tr>
        <th>Account</th>
        <th>Date</th>
        <th class="text-right">Video Views</th>
        <th class="text-right">Profile Views</th>
        <th class="text-right">Likes</th>
        <th class="text-right">Comments</th>
        <th class="text-right">Shares</th>
        <th class="text-muted">Updated</th>
      </tr>
    </thead>
    <tbody>
      <% @stats.each do |stat| %>
        <tr>
          <td><span class="badge badge-blue"><%= stat.account.titleize %></span></td>
          <td class="mono"><%= stat.date.strftime("%Y-%m-%d") %></td>
          <td class="text-right mono"><%= number_with_delimiter(stat.video_views) %></td>
          <td class="text-right mono"><%= number_with_delimiter(stat.profile_views) %></td>
          <td class="text-right mono"><%= number_with_delimiter(stat.likes) %></td>
          <td class="text-right mono"><%= number_with_delimiter(stat.comments) %></td>
          <td class="text-right mono"><%= number_with_delimiter(stat.shares) %></td>
          <td class="text-muted" style="font-size: 0.75rem;"><%= stat.updated_at.strftime("%b %d %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty">No TikTok stats yet. Upload a CSV or ZIP to get started.</div>
<% end %>
