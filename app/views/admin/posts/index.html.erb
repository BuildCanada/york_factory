<div class="page-header">
  <h1>Posts</h1>
  <a href="<%= new_admin_post_path %>" class="btn btn-primary">New Post</a>
</div>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Slug</th>
      <th>Status</th>
      <th>Published</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><a href="<%= admin_post_path(post) %>"><%= post.title_en || "Untitled" %></a></td>
        <td class="mono"><%= post.slug %></td>
        <td>
          <span class="badge badge-<%= { 'published' => 'green', 'draft' => 'yellow', 'scheduled' => 'blue' }[post.publish_status] %>">
            <%= post.publish_status.capitalize %>
          </span>
          <% if post.hidden? %><span class="badge badge-red">Hidden</span><% end %>
        </td>
        <td class="text-muted"><%= post.published_at&.strftime("%b %d, %Y") || "—" %></td>
        <td class="text-right">
          <a href="<%= edit_admin_post_path(post) %>" class="btn btn-sm">Edit</a>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "admin/shared/pagination", pagy: @pagy %>
