<style>
  .search-index-status { display: flex; gap: 1.25rem; flex-wrap: wrap; margin-bottom: 1rem; padding: 0.65rem 1rem; }
  .search-index-status-item { display: flex; gap: 0.4rem; align-items: baseline; font-size: 0.8rem; }
  .search-index-status-item span { color: var(--muted); }
  .search-index-status-item strong { font-variant-numeric: tabular-nums; }
  .search-query-card { margin-bottom: 1rem; }
  .search-query-row { display: flex; gap: 0.65rem; }
  .search-query-input { min-width: 0; flex: 1; padding: 0.75rem 0.9rem; font-size: 1.05rem; }
  .search-query-button { flex: 0 0 auto; padding-inline: 1.25rem; }
  .search-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1rem; align-items: start; }
  .search-filters { position: sticky; top: 1rem; }
  .search-filter-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 0.75rem; }
  .search-filter-grid .wide { grid-column: 1 / -1; }
  .search-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .search-check { display: flex; align-items: flex-start; gap: 0.5rem; margin: 0.65rem 0; font-size: 0.82rem; }
  .search-check input { accent-color: var(--accent); margin-top: 0.2rem; }
  .search-help { color: var(--muted); font-size: 0.78rem; margin-top: 0.3rem; }
  .search-section { margin-bottom: 1rem; }
  .search-results-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.25rem; }
  .search-results-header h1 { margin: 0; font-size: 1.1rem; }
  .search-result { border-top: 1px solid var(--border); padding: 1rem 0; }
  .search-results-header + .search-result { border-top: none; }
  .search-result-title { font-size: 1rem; font-weight: 600; overflow-wrap: anywhere; }
  .search-result-meta { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.4rem 0; color: var(--muted); font-size: 0.78rem; }
  .search-result p { color: #b4b4bb; font-size: 0.87rem; margin-top: 0.4rem; }
  .search-code { background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 0.75rem; overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; font: 0.75rem/1.5 "SF Mono", "Fira Code", monospace; }
  .search-details { border-top: 1px solid var(--border); margin-top: 0.75rem; padding-top: 0.5rem; }
  .search-details summary { color: var(--muted); cursor: pointer; font-size: 0.8rem; padding: 0.25rem 0; }
  .search-details[open] summary { color: var(--text); margin-bottom: 0.75rem; }
  .search-table-actions { display: flex; gap: 0.4rem; align-items: center; }
  .search-table-actions form { margin: 0; }
  .search-empty { min-height: 210px; display: grid; place-items: center; text-align: center; color: var(--muted); }
  .search-empty strong { display: block; color: var(--text); font-size: 1rem; margin-bottom: 0.25rem; }
  .search-filters textarea.form-control { min-height: 90px; }
  @media (max-width: 980px) {
    .search-layout { grid-template-columns: 1fr; }
    .search-filters { position: static; grid-row: 1; }
  }
  @media (max-width: 620px) {
    .search-query-row { flex-direction: column; }
    .search-filter-grid { grid-template-columns: 1fr; }
    .search-filter-grid .wide { grid-column: auto; }
  }
</style>

<div class="page-header">
  <div>
    <h1>Search documents</h1>
    <div class="text-muted">Search media, government spending, and KPI records in Turbopuffer.</div>
  </div>
</div>

<% if @form_errors.present? %>
  <div class="flash flash-alert" id="search-errors">
    <strong>Could not complete the search.</strong>
    <ul style="margin: 0.35rem 0 0 1.25rem;">
      <% @form_errors.each do |error| %><li><%= error %></li><% end %>
    </ul>
  </div>
<% end %>

<div class="card search-index-status" aria-label="Search index status">
  <div class="search-index-status-item"><span>Namespace</span><strong><%= @search_namespace %></strong></div>
  <div class="search-index-status-item"><span>Checkpoint</span><strong><%= number_with_delimiter(@search_checkpoint) %></strong></div>
  <div class="search-index-status-item"><span>Records</span><strong><%= number_with_delimiter(@searchable_record_count) %></strong></div>
  <div class="search-index-status-item"><span>Pending</span><strong><%= number_with_delimiter(@pending_search_sync_count) %></strong></div>
</div>

<%= form_with url: admin_search_path, method: :post, scope: :search, data: { turbo: false }, id: "search-workbench" do |form| %>
  <section class="card search-query-card">
    <%= form.label :text, "Search documents", style: "display: block; font-weight: 600; margin-bottom: 0.45rem;" %>
    <div class="search-query-row">
      <%= form.search_field :text,
        value: @form["text"],
        class: "form-control search-query-input",
        placeholder: "Search for people, topics, programs, or exact phrases…",
        autofocus: true,
        enterkeyhint: "search" %>
      <%= button_tag "Search", type: "submit", name: "operation", value: "query", class: "btn btn-primary search-query-button" %>
    </div>
    <div class="search-help">Press Enter to search. Hybrid mode combines exact keyword matching with semantic similarity.</div>
  </section>

  <div class="search-layout">
    <main>
      <section class="card search-section" id="search-results" aria-live="polite">
        <% if @result %>
          <div class="search-results-header">
            <h1><%= @result.rows.length %> result<%= "s" unless @result.rows.one? %><%= " for #{@tested_saved_search.name}" if @tested_saved_search %></h1>
            <span class="badge badge-blue"><%= @result.query_count %> provider quer<%= @result.query_count == 1 ? "y" : "ies" %></span>
          </div>
          <% if @result.rows.empty? %>
            <div class="search-empty">
              <div><strong>No matching documents</strong>Try a broader phrase, another search mode, or fewer filters.</div>
            </div>
          <% else %>
            <% @result.rows.each do |raw_row| %>
              <% row = raw_row.with_indifferent_access %>
              <article class="search-result">
                <div class="search-result-title">
                  <% if row[:canonical_url].present? %>
                    <%= link_to(row[:title].presence || row[:id], row[:canonical_url], target: "_blank", rel: "noopener") %>
                  <% else %>
                    <%= row[:title].presence || row[:id] %>
                  <% end %>
                </div>
                <div class="search-result-meta">
                  <span class="badge badge-blue"><%= row[:realm] %></span>
                  <span><%= row[:record_type] %></span>
                  <% if row[:publisher_name].present? || row[:source_name].present? %><span><%= row[:publisher_name] || row[:source_name] %></span><% end %>
                  <% if row[:published_at].present? %>
                    <% published_at = Time.zone.parse(row[:published_at].to_s) %>
                    <span><%= published_at ? l(published_at, format: :long) : row[:published_at] %></span>
                  <% end %>
                  <% if row[:"$dist"].present? %><span>distance <%= number_with_precision(row[:"$dist"].to_f, precision: 4) %></span><% end %>
                  <% if row[:amount].present? %><span><%= number_to_currency(row[:amount], unit: "#{row[:currency] || 'CAD'} ") %></span><% end %>
                  <% if row[:kpi_last_updated_at].present? %><span>Updated <%= Time.zone.parse(row[:kpi_last_updated_at].to_s).to_fs(:long) %></span><% end %>
                </div>
                <% if row[:summary].present? %><p><%= truncate(row[:summary], length: 500) %></p><% end %>
                <details class="search-details">
                  <summary>Raw Turbopuffer row</summary>
                  <pre class="search-code"><%= JSON.pretty_generate(raw_row) %></pre>
                </details>
              </article>
            <% end %>
          <% end %>
          <details class="search-details">
            <summary>Query definition and provider telemetry</summary>
            <pre class="search-code"><%= JSON.pretty_generate(definition: @executed_definition, billing: @result.billing, performance: @result.performance) %></pre>
          </details>
        <% else %>
          <div class="search-empty">
            <div><strong>Search the document index</strong>Enter a query above or use filters for a structured search.</div>
          </div>
        <% end %>
      </section>
    </main>

    <aside class="search-filters" id="search-filters">
      <section class="card search-section">
        <h2>Filters</h2>
        <div class="search-filter-grid">
          <div class="form-group wide">
            <%= form.label :realm %>
            <%= form.select :realm, Search::Realms.keys.map { |realm| [realm.humanize, realm] }, { selected: @form["realm"] }, class: "form-control" %>
          </div>
          <div class="form-group wide">
            <%= form.label :mode, "Search mode" %>
            <%= form.select :mode, [["Hybrid", "hybrid"], ["Keywords", "lexical"], ["Semantic", "semantic"], ["Filters only", "filter_only"]], { selected: @form["mode"] }, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= form.label :language %>
            <%= form.select :language, [["English", "en"], ["French", "fr"]], { selected: @form["language"] }, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= form.label :limit, "Results" %>
            <%= form.number_field :limit, value: @form["limit"], min: 1, max: 100, class: "form-control" %>
          </div>
          <div class="form-group wide">
            <%= form.label :publisher_domain, "Publisher" %>
            <%= form.select :publisher_domain, @publishers.map { |publisher| [publisher.fetch("name"), publisher.fetch("domain")] }, { include_blank: "All publishers", selected: @form["publisher_domain"] }, class: "form-control" %>
          </div>
          <div class="form-group wide">
            <%= form.label :content_type, "Content type" %>
            <%= form.select :content_type, Search::Realms::Media::CONTENT_TYPES.map { |type| [type.humanize, type] }, { include_blank: "All types", selected: @form["content_type"] }, class: "form-control" %>
          </div>
          <div class="form-group wide">
            <%= form.label :published_after, "Published after" %>
            <%= form.datetime_local_field :published_after, value: @form["published_after"], class: "form-control" %>
          </div>
        </div>

        <details class="search-details">
          <summary>Search tuning</summary>
          <div class="form-group">
            <%= form.label :lexical_match, "Keyword matching" %>
            <%= form.select :lexical_match, [["All words", "all_tokens"], ["Any word", "any_tokens"], ["Exact phrase", "phrase"]], { selected: @form["lexical_match"] }, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= form.label :semantic_max_distance, "Maximum semantic distance" %>
            <%= form.number_field :semantic_max_distance, value: @form["semantic_max_distance"], min: 0, step: 0.01, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= form.label :filters_json, "Advanced filters (JSON)" %>
            <%= form.text_area :filters_json, value: @form["filters_json"], class: "form-control", placeholder: '{"field":"section","op":"eq","value":"Politics"}' %>
          </div>
        </details>
      </section>

      <section class="card search-section">
        <details class="search-details" style="border-top: 0; margin-top: 0; padding-top: 0;" <%= "open" if @form["name"].present? %>>
          <summary><strong>Save as an alert</strong></summary>
          <div class="form-group">
            <%= form.label :name, "Alert name" %>
            <%= form.text_field :name, value: @form["name"], class: "form-control", placeholder: "Generated when blank" %>
          </div>
          <div class="search-filter-grid">
            <div class="form-group wide">
              <%= form.label :start_policy, "First run" %>
              <%= form.select :start_policy, [["Future matches only", "future_only"], ["Include existing matches", "backfill"]], { selected: @form["start_policy"] }, class: "form-control" %>
            </div>
            <div class="form-group wide">
              <%= form.label :poll_interval_seconds, "Check every" %>
              <%= form.select :poll_interval_seconds, [["1 minute", 60], ["5 minutes", 300], ["15 minutes", 900], ["1 hour", 3600], ["1 day", 86400]], { selected: @form["poll_interval_seconds"].to_i }, class: "form-control" %>
            </div>
            <div class="form-group">
              <%= form.label :delivery_mode %>
              <%= form.select :delivery_mode, [["Instant", "instant"], ["Digest", "digest"]], { selected: @form["delivery_mode"] }, class: "form-control" %>
            </div>
            <div class="form-group">
              <%= form.label :digest_interval_seconds, "Digest every" %>
              <%= form.select :digest_interval_seconds, [["Hour", 3600], ["6 hours", 21600], ["Day", 86400]], { selected: @form["digest_interval_seconds"].to_i }, class: "form-control" %>
            </div>
          </div>
          <div class="search-help">Matches will be emailed to the signed-in admin.</div>
          <label class="search-check"><%= form.check_box :notify_on_update, { checked: ActiveModel::Type::Boolean.new.cast(@form["notify_on_update"]) }, "1", "0" %> Notify when a matched document changes</label>
          <%= button_tag "Save alert", type: "submit", name: "operation", value: "save", class: "btn" %>
        </details>
      </section>

      <details class="card search-details search-section" style="margin-top: 0;">
        <summary>Schema reference</summary>
        <% @realm_contracts.each do |realm, contract| %>
          <div style="margin-bottom: 0.75rem;">
            <strong style="font-size: 0.8rem;"><%= realm.humanize %></strong>
            <div class="search-help">Facets: <%= contract.facet_fields.join(", ").presence || "None" %></div>
            <details class="search-details">
              <summary>Filter fields</summary>
              <div class="search-code"><%= contract.filter_fields.sort.map { |field, operators| "#{field}: #{operators.join(', ')}" }.join("\n") %></div>
            </details>
          </div>
        <% end %>
      </details>
    </aside>
  </div>
<% end %>

<section style="margin-top: 1.5rem;" id="saved-searches">
  <h2>Saved searches</h2>
  <% if @saved_searches.empty? %>
    <div class="card empty">No saved searches yet.</div>
  <% else %>
    <table>
      <thead><tr><th>Name</th><th>Realm / mode</th><th>Schedule</th><th>Delivery</th><th>Next run</th><th></th></tr></thead>
      <tbody>
        <% @saved_searches.each do |saved_search| %>
          <tr>
            <td><strong><%= saved_search.name %></strong><br><span class="text-muted"><%= truncate(saved_search.definition["text"], length: 70) %></span></td>
            <td><span class="badge badge-blue"><%= saved_search.realm %></span> <%= saved_search.definition["mode"] %></td>
            <td>Every <%= distance_of_time_in_words(saved_search.poll_interval_seconds) %><br><span class="text-muted"><%= saved_search.start_policy.humanize %></span></td>
            <td><%= saved_search.delivery_mode.humanize %><br><span class="text-muted"><%= Array(saved_search.delivery_configuration["channels"]).join(", ") %></span></td>
            <td><%= saved_search.next_run_at ? time_ago_in_words(saved_search.next_run_at) : "Not scheduled" %></td>
            <td>
              <div class="search-table-actions">
                <%= button_to "Test", admin_test_saved_search_path(saved_search), method: :post, class: "btn btn-sm" %>
                <%= button_to "Delete", admin_search_saved_search_path(saved_search), method: :delete, class: "btn btn-danger btn-sm", form: { data: { turbo_confirm: "Delete this saved search?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
