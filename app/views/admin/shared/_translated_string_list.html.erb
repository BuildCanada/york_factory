<%# locals: (form:, field:, label: nil) %>
<% field_label = label || field.to_s.humanize %>
<div class="form-group" data-controller="tabs">
  <label><%= field_label %></label>
  <div class="tab-bar">
    <button type="button" class="tab-btn active" data-tabs-target="tab" data-action="tabs#select">EN</button>
    <button type="button" class="tab-btn" data-tabs-target="tab" data-action="tabs#select">FR</button>
  </div>
  <% %i[en fr].each_with_index do |locale, idx| %>
    <% values = Array(form.object.public_send(:"#{field}_#{locale}")) %>
    <div class="tab-panel" data-tabs-target="panel" style="<%= idx.zero? ? "" : "display:none" %>">
      <div data-controller="list">
        <%= hidden_field_tag "#{form.object_name}[#{field}_#{locale}][]", "" %>
        <div data-list-target="items">
          <% values.each do |value| %>
            <% str = value.is_a?(Hash) ? (value["message"] || value[:message]) : value %>
            <div class="form-row mb-1" data-list-item>
              <%= form.text_field :"#{field}_#{locale}", multiple: true, value: str, class: "form-control", style: "flex:1" %>
              <button type="button" class="btn btn-sm" data-action="list#remove">Remove</button>
            </div>
          <% end %>
        </div>
        <template data-list-target="template">
          <div class="form-row mb-1" data-list-item>
            <%= form.text_field :"#{field}_#{locale}", multiple: true, value: "", class: "form-control", style: "flex:1", placeholder: locale == :fr ? "Auto-translated if blank" : nil %>
            <button type="button" class="btn btn-sm" data-action="list#remove">Remove</button>
          </div>
        </template>
        <button type="button" class="btn btn-sm" data-action="list#add">Add</button>
      </div>
    </div>
  <% end %>
</div>
