<div class="page-header">
  <h1>Team Members</h1>
  <a href="<%= new_admin_team_member_path %>" class="btn btn-primary">New Member</a>
</div>

<%= form_with url: admin_team_members_path, method: :get, local: true, class: "mb-2" do %>
  <label for="role">Filter by role:</label>
  <select name="role" id="role" onchange="this.form.submit()">
    <option value="">All roles</option>
    <% @roles.each do |role| %>
      <option value="<%= role %>" <%= "selected" if @selected_role == role %>><%= role.humanize.titleize %></option>
    <% end %>
  </select>
  <label for="min_memos" style="margin-left:1em">Min memos:</label>
  <select name="min_memos" id="min_memos" onchange="this.form.submit()">
    <% [["Any", nil], ["0 (none)", "0"], ["1+", "1"], ["3+", "3"], ["5+", "5"], ["10+", "10"]].each do |label, val| %>
      <option value="<%= val %>" <%= "selected" if !@min_memos.nil? && @min_memos.to_s == val.to_s %>><%= label %></option>
    <% end %>
  </select>
  <% if @selected_role || @min_memos %>
    <%= link_to "Clear", admin_team_members_path, class: "btn btn-sm" %>
  <% end %>
<% end %>

<table>
  <thead>
    <tr>
      <th style="width:40px"></th>
      <th>Name</th>
      <th>Role</th>
      <th>Memos</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody data-controller="sortable" data-sortable-url-value="<%= reorder_admin_team_members_path %>">
    <% @team_members.each do |member| %>
      <tr data-id="<%= member.id %>">
        <td><span class="drag-handle">&#9776;</span></td>
        <td><a href="<%= admin_team_member_path(member) %>"><%= member.name %></a></td>
        <td>
          <%= form_with model: [:admin, member], method: :patch, local: true do |f| %>
            <%= f.select :role,
                  %w[board advisor volunteer memo_author employee].map { |r| [r.humanize.titleize, r] },
                  { include_blank: "— None —" },
                  onchange: "this.form.requestSubmit()" %>
          <% end %>
        </td>
        <td><%= @memo_counts[member.id] %></td>
        <td>
          <span class="badge badge-<%= { 'published' => 'green', 'draft' => 'yellow', 'scheduled' => 'blue' }[member.publish_status] %>">
            <%= member.publish_status.capitalize %>
          </span>
        </td>
        <td class="text-right"><a href="<%= edit_admin_team_member_path(member) %>" class="btn btn-sm">Edit</a></td>
      </tr>
    <% end %>
  </tbody>
</table>
