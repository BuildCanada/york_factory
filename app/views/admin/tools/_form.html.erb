<%= form_with(model: [:admin, tool], class: "card") do |f| %>
  <% if tool.errors.any? %>
    <div class="flash flash-alert">
      <% tool.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <%= render "admin/shared/translated_text_field", form: f, field: :title %>
  <%= render "admin/shared/slug_field", form: f %>
  <%= render "admin/shared/translated_rich_text", form: f, field: :description, retranslate_url: tool.persisted? ? retranslate_admin_tool_path(tool) : nil %>

  <div class="form-group">
    <label>URL</label>
    <%= f.text_field :url, class: "form-control" %>
  </div>

  <div class="form-group">
    <label>Size</label>
    <%= f.select :size, %w[small big], {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <label>Accent Color</label>
    <%= f.text_field :accent_color, class: "form-control", placeholder: "#3b82f6" %>
  </div>

  <div class="form-group">
    <label><%= f.check_box :featured %> Featured</label>
  </div>

  <%= render "admin/shared/file_upload", form: f, field: :image %>
  <%= render "admin/shared/publish_fields", form: f %>

  <div class="btn-group mt-1">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <a href="<%= tool.persisted? ? admin_tool_path(tool) : admin_tools_path %>" class="btn">Cancel</a>
  </div>
<% end %>
