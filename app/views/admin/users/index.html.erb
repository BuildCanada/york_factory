<div class="page-header">
  <h1>Users</h1>
  <a href="<%= new_admin_user_path %>" class="btn btn-primary">New User</a>
</div>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Role</th>
      <th>Last Sign In</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr<%= ' style="background: rgba(59,130,246,0.06);"'.html_safe if user.id == current_user.id %>>
        <td>
          <%= user.name || "—" %>
          <% if user.id == current_user.id %>
            <span class="text-muted" style="font-size: 0.75rem;">(you)</span>
          <% end %>
        </td>
        <td class="mono"><%= user.email %></td>
        <td>
          <% badge_color = user.superadmin? ? 'red' : (user.admin? ? 'green' : 'blue') %>
          <span class="badge badge-<%= badge_color %>">
            <%= user.role.capitalize %>
          </span>
        </td>
        <td class="text-muted"><%= user.last_sign_in_at&.strftime("%Y-%m-%d %H:%M") || "Never" %></td>
        <td class="text-right">
          <% unless user.id == current_user.id %>
            <a href="<%= edit_admin_user_path(user) %>" class="btn btn-sm">Edit</a>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "admin/shared/pagination", pagy: @pagy %>
