<% if events.empty? %>
  <p class="text-muted">No activity yet.</p>
<% else %>
  <table>
    <thead><tr><th>When</th><th>Event</th><th>By</th><th>IP</th><th>Details</th></tr></thead>
    <tbody>
      <% events.each do |event| %>
        <tr>
          <td><%= developer_time(event.created_at) %></td>
          <td class="mono"><%= event.action %></td>
          <td><%= event.actor_label %></td>
          <td class="mono"><%= event.ip %></td>
          <td class="mono"><%= event.metadata.except("changes").map { |k, v| "#{k}: #{Array(v).join(', ')}" }.join("; ") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
