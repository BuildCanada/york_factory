<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
  <title>York Factory Admin</title>
  <%= javascript_importmap_tags %>
  <%= stylesheet_link_tag "marksmith" %>
  <style>
    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --border: #2a2d37;
      --text: #e4e4e7;
      --muted: #71717a;
      --accent: #3b82f6;
      --green: #22c55e;
      --yellow: #eab308;
      --red: #ef4444;
      --sidebar-w: 220px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* Layout */
    .admin-layout { display: flex; min-height: 100vh; }

    /* Sidebar */
    .sidebar { width: var(--sidebar-w); background: var(--surface); border-right: 1px solid var(--border); padding: 1rem 0; flex-shrink: 0; position: fixed; top: 0; bottom: 0; overflow-y: auto; }
    .sidebar-brand { padding: 0 1rem 1rem; font-weight: 700; font-size: 1.1rem; color: var(--text); border-bottom: 1px solid var(--border); margin-bottom: 0.5rem; }
    .sidebar-section-toggle { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1rem; font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; cursor: pointer; user-select: none; }
    .sidebar-section-toggle:hover { color: var(--text); }
    .chevron { display: inline-block; transition: transform 0.15s; font-size: 0.6rem; }
    .chevron.open { transform: rotate(90deg); }
    .sidebar-links { list-style: none; }
    .sidebar-links li a { display: block; padding: 0.35rem 1rem 0.35rem 1.5rem; font-size: 0.85rem; color: var(--muted); }
    .sidebar-links li a:hover, .sidebar-links li a.active { color: var(--text); text-decoration: none; background: rgba(255,255,255,0.04); }
    .sidebar-divider { border-top: 1px solid var(--border); margin: 0.5rem 0; }
    .sidebar-bottom { position: absolute; bottom: 0; width: 100%; padding: 0.75rem 1rem; border-top: 1px solid var(--border); }
    .sidebar-bottom a { font-size: 0.8rem; color: var(--muted); }

    /* Main content */
    .main-content { margin-left: var(--sidebar-w); flex: 1; padding: 1.5rem 2rem; max-width: calc(100% - var(--sidebar-w)); }

    /* Typography */
    h1 { font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem; }
    h2 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.75rem; }

    /* Grid & Cards */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; }
    .card .label { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .card .value { font-size: 1.75rem; font-weight: 700; margin-top: 0.25rem; }

    /* Tables */
    table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 2rem; }
    th { text-align: left; padding: 0.6rem 1rem; font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); background: var(--surface); }
    td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.875rem; }
    tr:last-child td { border-bottom: none; }

    /* Badges */
    .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; }
    .badge-green { background: rgba(34,197,94,0.15); color: var(--green); }
    .badge-yellow { background: rgba(234,179,8,0.15); color: var(--yellow); }
    .badge-red { background: rgba(239,68,68,0.15); color: var(--red); }
    .badge-blue { background: rgba(59,130,246,0.15); color: var(--accent); }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.9rem; border-radius: 6px; font-size: 0.85rem; font-weight: 500; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; text-decoration: none; }
    .btn:hover { background: var(--border); text-decoration: none; }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-primary:hover { opacity: 0.9; }
    .btn-danger { background: var(--red); border-color: var(--red); color: #fff; }
    .btn-danger:hover { opacity: 0.9; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-sm { padding: 0.25rem 0.6rem; font-size: 0.75rem; }
    .btn-group { display: flex; gap: 0.5rem; align-items: center; }

    /* Forms */
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.03em; font-weight: 500; }
    .form-control { width: 100%; padding: 0.5rem 0.75rem; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 0.9rem; font-family: inherit; }
    .form-control:focus { outline: none; border-color: var(--accent); }
    textarea.form-control { min-height: 120px; resize: vertical; }
    select.form-control { appearance: auto; }
    input[type="file"].form-control { padding: 0.35rem 0.5rem; }
    input[type="datetime-local"].form-control { color-scheme: dark; }

    /* Tabs (EN/FR) */
    .tab-bar { display: flex; gap: 0; margin-bottom: 0; border-bottom: 1px solid var(--border); }
    .tab-btn { padding: 0.4rem 1rem; font-size: 0.8rem; font-weight: 500; color: var(--muted); background: transparent; border: none; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
    .tab-panel { padding-top: 0.75rem; }

    /* Flash messages */
    .flash { padding: 0.6rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.85rem; }
    .flash-notice { background: rgba(34,197,94,0.12); color: var(--green); border: 1px solid rgba(34,197,94,0.3); }
    .flash-alert { background: rgba(239,68,68,0.12); color: var(--red); border: 1px solid rgba(239,68,68,0.3); }

    /* Header bar */
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .page-header h1 { margin-bottom: 0; }

    /* Filter bar */
    .filter-bar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
    .filter-input { flex: 1; max-width: 360px; }
    .filter-input[type="search"]::-webkit-search-cancel-button { filter: invert(0.6); cursor: pointer; }
    .filter-count { font-size: 0.8rem; }

    /* File preview */
    .file-preview { max-width: 120px; max-height: 80px; border-radius: 4px; margin-top: 0.3rem; }

    /* Drag handle */
    .drag-handle { cursor: grab; color: var(--muted); padding: 0 0.5rem; }

    /* Rendered markdown (admin show pages) */
    .rendered-markdown { font-size: 0.9rem; line-height: 1.6; }
    .rendered-markdown h1, .rendered-markdown h2, .rendered-markdown h3,
    .rendered-markdown h4, .rendered-markdown h5, .rendered-markdown h6 {
      margin: 1.25rem 0 0.5rem; font-weight: 600; color: var(--text); text-transform: none; letter-spacing: normal;
    }
    .rendered-markdown h1 { font-size: 1.3rem; }
    .rendered-markdown h2 { font-size: 1.15rem; }
    .rendered-markdown h3 { font-size: 1rem; }
    .rendered-markdown h2 .anchor, .rendered-markdown h3 .anchor,
    .rendered-markdown h1 .anchor, .rendered-markdown h4 .anchor,
    .rendered-markdown h5 .anchor, .rendered-markdown h6 .anchor { display: none; }
    .rendered-markdown p { margin: 0 0 0.75rem; }
    .rendered-markdown ul, .rendered-markdown ol { margin: 0 0 0.75rem 1.25rem; }
    .rendered-markdown li { margin-bottom: 0.2rem; }
    .rendered-markdown img { max-width: 100%; height: auto; border-radius: 4px; margin: 0.5rem 0; }
    .rendered-markdown blockquote { margin: 0 0 0.75rem; padding: 0.25rem 0.75rem; border-left: 3px solid var(--border); color: var(--muted); }
    .rendered-markdown code { background: var(--bg); padding: 0.1rem 0.35rem; border-radius: 3px; font-family: "SF Mono", "Fira Code", monospace; font-size: 0.85em; }
    .rendered-markdown pre { background: var(--bg); padding: 0.75rem; border-radius: 6px; overflow-x: auto; margin: 0 0 0.75rem; }
    .rendered-markdown pre code { background: transparent; padding: 0; }
    .rendered-markdown hr { border: none; border-top: 1px solid var(--border); margin: 1rem 0; }
    .rendered-markdown table { width: auto; margin: 0 0 0.75rem; }

    /* Slug history hovercard */
    .slug-history { position: relative; display: inline-block; }
    .slug-history-trigger { margin-left: 0.4rem; color: var(--muted); cursor: help; font-size: 0.75rem; border: 1px solid var(--border); border-radius: 999px; padding: 0 0.4rem; user-select: none; }
    .slug-history-trigger:hover { color: var(--text); border-color: var(--muted); }
    .slug-history-card { position: absolute; top: 100%; left: 0; margin-top: 0.4rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 0.6rem 0.75rem; min-width: 280px; max-width: 400px; box-shadow: 0 6px 20px rgba(0,0,0,0.4); z-index: 10; display: none; }
    .slug-history:hover .slug-history-card, .slug-history:focus-within .slug-history-card { display: block; }
    .slug-history-card-title { display: block; font-size: 0.7rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .slug-history-row { display: grid; grid-template-columns: 1.25rem 1fr; gap: 0.5rem; padding: 0.35rem 0; font-size: 0.8rem; border-top: 1px solid var(--border); align-items: baseline; }
    .slug-history-card-title + .slug-history-row { border-top: none; padding-top: 0.1rem; }
    .slug-history-marker { display: inline-flex; align-items: center; justify-content: center; width: 1.25rem; height: 1.25rem; border-radius: 999px; background: var(--bg); border: 1px solid var(--border); color: var(--muted); font-size: 0.65rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .slug-history-row.is-current .slug-history-marker { background: rgba(34,197,94,0.15); color: var(--green); border-color: rgba(34,197,94,0.3); }
    .slug-history-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
    .slug-history-card .slug-value { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.78rem; word-break: break-all; color: var(--text); }
    .slug-history-row:not(.is-current) .slug-value { color: var(--muted); text-decoration: line-through; text-decoration-color: rgba(113,113,122,0.5); }
    .slug-meta { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
    .slug-history-card .slug-date { color: var(--muted); font-size: 0.7rem; white-space: nowrap; }

    /* Utility */
    .mono { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.8rem; }
    .text-muted { color: var(--muted); }
    .text-right { text-align: right; }
    .empty { padding: 2rem; text-align: center; color: var(--muted); }
    .mt-1 { margin-top: 0.5rem; }
    .mb-2 { margin-bottom: 1rem; }
  </style>
</head>
<body>
  <div class="admin-layout">
    <nav class="sidebar" data-controller="sidebar">
      <div class="sidebar-brand">
        <a href="<%= admin_root_path %>" style="color: inherit; text-decoration: none;">York Factory</a>
      </div>

      <% if current_user %>
        <div class="sidebar-section-toggle" data-action="click->sidebar#toggle" data-sidebar-key="pipeline">
          Pipeline <span class="chevron open">&#9654;</span>
        </div>
        <ul class="sidebar-links" data-sidebar-target="section" data-sidebar-key="pipeline">
          <li><a href="<%= admin_root_path %>" class="<%= 'active' if controller_name == 'dashboard' && action_name == 'scraping' %>">Scraping</a></li>
          <li><a href="/admin/ingestions" class="<%= 'active' if controller_name == 'dashboard' && action_name == 'ingestions' %>">Ingestions</a></li>
          <li><a href="<%= admin_records_path %>" class="<%= 'active' if controller_name == 'records' %>">Records</a></li>
          <li><a href="/admin/lineage_review" class="<%= 'active' if controller_name == 'dashboard' && action_name == 'lineage_review' %>">Lineage Review</a></li>
          <li><a href="<%= admin_search_path %>" class="<%= 'active' if controller_path == 'admin/search' %>">Search</a></li>
          <li><a href="<%= admin_media_feeds_path %>" class="<%= 'active' if controller_path == 'admin/media_feeds' %>">Media Feeds</a></li>
          <% if current_user.superadmin? %>
            <li><a href="/admin/jobs">Jobs</a></li>
          <% end %>
        </ul>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-toggle" data-action="click->sidebar#toggle" data-sidebar-key="kpis">
          KPIs <span class="chevron open">&#9654;</span>
        </div>
        <ul class="sidebar-links" data-sidebar-target="section" data-sidebar-key="kpis">
          <li><a href="/admin/kpis/agent_runs" class="<%= 'active' if controller_path == 'admin/kpis/agent_runs' %>">Agent Runs</a></li>
          <li><a href="/admin/kpis/measures" class="<%= 'active' if controller_path == 'admin/kpis/measures' %>">Measures</a></li>
          <li><a href="/admin/kpis/citations" class="<%= 'active' if controller_path == 'admin/kpis/citations' %>">Citations</a></li>
        </ul>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-toggle" data-action="click->sidebar#toggle" data-sidebar-key="cms">
          CMS <span class="chevron open">&#9654;</span>
        </div>
        <ul class="sidebar-links" data-sidebar-target="section" data-sidebar-key="cms">
          <li><a href="/admin/posts" class="<%= 'active' if controller_name == 'posts' %>">Posts</a></li>
          <li><a href="/admin/memos" class="<%= 'active' if controller_name == 'memos' %>">Memos</a></li>
          <li><a href="/admin/builders" class="<%= 'active' if controller_name == 'builders' %>">Builders</a></li>
          <li><a href="/admin/team_members" class="<%= 'active' if controller_name == 'team_members' %>">Team</a></li>
          <li><a href="/admin/tools" class="<%= 'active' if controller_name == 'tools' %>">Tools</a></li>
          <li><a href="/admin/faqs" class="<%= 'active' if controller_name == 'faqs' %>">FAQs</a></li>
          <li><a href="/admin/feed_entries" class="<%= 'active' if controller_name == 'feed_entries' %>">Feed</a></li>
          <li><a href="/admin/testimonials" class="<%= 'active' if controller_name == 'testimonials' %>">Testimonials</a></li>
          <li><a href="/admin/critiques" class="<%= 'active' if controller_name == 'critiques' %>">Critiques<% pending = (Critique.pending.count rescue 0); if pending > 0 %> <span class="badge badge-yellow"><%= pending %></span><% end %></a></li>
          <li><a href="/admin/subscribers" class="<%= 'active' if controller_name == 'subscribers' %>">Subscribers</a></li>
        </ul>

        <% if current_user.can_edit_trade_barriers? %>
          <div class="sidebar-divider"></div>

          <div class="sidebar-section-toggle" data-action="click->sidebar#toggle" data-sidebar-key="trade_barriers">
            Trade Barriers <span class="chevron open">&#9654;</span>
          </div>
          <ul class="sidebar-links" data-sidebar-target="section" data-sidebar-key="trade_barriers">
            <li><a href="/admin/trade_barriers/agreements" class="<%= 'active' if controller_name == 'agreements' && controller_path.start_with?('admin/trade_barriers') %>">Agreements</a></li>
            <li><a href="/admin/trade_barriers/themes" class="<%= 'active' if controller_name == 'themes' && controller_path.start_with?('admin/trade_barriers') %>">Themes</a></li>
          </ul>
        <% end %>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-toggle" data-action="click->sidebar#toggle" data-sidebar-key="elections">
          Elections <span class="chevron open">&#9654;</span>
        </div>
        <ul class="sidebar-links" data-sidebar-target="section" data-sidebar-key="elections">
          <li><a href="/admin/elections" class="<%= 'active' if controller_name == 'elections' %>">Elections</a></li>
        </ul>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-toggle" data-action="click->sidebar#toggle" data-sidebar-key="metrics">
          Metrics <span class="chevron open">&#9654;</span>
        </div>
        <ul class="sidebar-links" data-sidebar-target="section" data-sidebar-key="metrics">
          <li><a href="/admin/metrics" class="<%= 'active' if controller_name == 'overview' %>">Overview</a></li>
          <li><a href="/admin/metrics/twitter_stats" class="<%= 'active' if controller_name == 'twitter_stats' %>">Twitter Stats</a></li>
          <li><a href="/admin/metrics/linkedin_stats" class="<%= 'active' if controller_name == 'linkedin_stats' %>">LinkedIn Stats</a></li>
          <li><a href="/admin/metrics/substack_stats" class="<%= 'active' if controller_name == 'substack_stats' %>">Substack Stats</a></li>
          <li><a href="/admin/metrics/tiktok_stats" class="<%= 'active' if controller_name == 'tiktok_stats' %>">TikTok Stats</a></li>
          <li><a href="/admin/metrics/instagram_stats" class="<%= 'active' if controller_name == 'instagram_stats' %>">Instagram Stats</a></li>
        </ul>

        <div class="sidebar-divider"></div>

        <div class="sidebar-section-toggle" data-action="click->sidebar#toggle" data-sidebar-key="settings">
          Settings <span class="chevron open">&#9654;</span>
        </div>
        <ul class="sidebar-links" data-sidebar-target="section" data-sidebar-key="settings">
          <li><a href="/admin/users" class="<%= 'active' if controller_name == 'users' %>">Users</a></li>
        </ul>

        <div class="sidebar-bottom">
          <span class="text-muted" style="font-size: 0.8rem;"><%= current_user.name || current_user.email %></span>
          <%= button_to "Logout", destroy_user_session_path, method: :delete, style: "float: right; background: none; border: none; color: var(--muted); font-size: 0.8rem; cursor: pointer; padding: 0;" %>
        </div>
      <% end %>
    </nav>

    <main class="main-content">
      <% if flash[:notice] %>
        <div class="flash flash-notice"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flash flash-alert"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
  </div>
</body>
</html>
