<!doctype html>
<html lang="<%= @locale %>"><head><meta charset="utf-8"><title><%= e(@title) %></title>
<style>
@font-face { font-family: Soehne; src: url('<%= font("soehne-kraftig.woff2") %>'); font-weight: 500; }
@font-face { font-family: Soehne; src: url('<%= font("soehne-fett.woff2") %>'); font-weight: 700; }
@font-face { font-family: Financier; src: url('<%= font("financier-text-regular.woff2") %>'); }
@font-face { font-family: Founders; src: url('<%= font("founders-grotesk-mono-regular.woff2") %>'); }
@font-face { font-family: 'Söhne Kräftig'; src: url('<%= font("soehne-kraftig.woff2") %>'); }
@page {
  size: letter;
  margin: 1in 0.65in 0.7in;
  background: #f3e7dc;
  @top-right { content: <%= css_string(@title) %>; text-align: right; font: 500 11pt/1.3 Soehne, sans-serif; color: #272727; vertical-align: middle; width: 65%; }
  @top-left { content: url("<%= logo(164.7692) %>"); vertical-align: middle; }
  @bottom-left { content: <%= css_string(poll_url.sub(%r{\Ahttps?://}, "")) %>; font: 8pt Founders, monospace; color: #272727; vertical-align: middle; }
  @bottom-right { content: counter(page); font: 9pt Founders, monospace; color: #272727; vertical-align: middle; }
}
@page :first {
  margin: 0;
  @top-left { content: none; }
  @top-right { content: none; }
  @bottom-left { content: none; }
  @bottom-right { content: none; }
}
* { box-sizing: border-box; }
html { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
body { margin: 0; color: #272727; font: 12pt/1.5 Financier, Georgia, serif; }
.cover { height: 11in; padding: 0.65in; background: #f3e7dc; display: flex; flex-direction: column; break-after: page; }
.cover-logo { width: 128px; height: 128px; align-self: flex-start; }
.eyebrow { font: 10pt/1.4 Founders, monospace; text-transform: uppercase; letter-spacing: 1.5px; }
.cover-title { margin-top: auto; margin-bottom: 0.65in; }
.cover h1 { color: #272727; font: 700 44pt/1.08 Soehne, sans-serif; letter-spacing: -1.5px; margin: 0 0 32px; overflow-wrap: anywhere; }
.cover-scope { font: 500 18pt/1.3 Soehne, sans-serif; margin: 0 0 8px; color: #272727; }
.cover-date { font: 12pt/1.5 Founders, monospace; margin: 0; color: #272727; }
h1,h2,h3,h4 { font-family: Soehne, sans-serif; line-height: 1.2; break-after: avoid; }
h1 { font-size: 26pt; } h2 { font-size: 22pt; margin-top: 30px; } h3 { font-size: 16pt; margin-top: 24px; }
p,li { orphans: 3; widows: 3; } a { color: #8c3031; text-decoration: underline; overflow-wrap: anywhere; }
.takeaways { border: 3px double #b6a79b; padding: 20px 24px; background: #f3e7dc; margin: 0 0 28px; }
.takeaways ol { margin-bottom: 0; padding-left: 23px; } .takeaways li { padding-left: 8px; margin-bottom: 12px; }
figure { margin: 24px 0; break-inside: avoid; } img { max-width: 100%; max-height: 7in; object-fit: contain; } figure img { width: 100%; }
blockquote { margin-left: 0; padding-left: 20px; border-left: 3px solid #8c3031; }
table { border-collapse: collapse; width: 100%; font-size: 10pt; table-layout: fixed; } thead { display: table-header-group; }
th,td { padding: 7px; text-align: left; border-bottom: 1px solid #d7cec7; overflow-wrap: anywhere; } th { background: #f3e7dc; font-family: Soehne; }
tr { break-inside: avoid; } pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 9pt; } code { font-family: Founders, monospace; }
.section { break-before: page; } .metadata { font-size: 11pt; }
</style></head><body>
<section class="cover">
  <img class="cover-logo" src="<%= cover_logo %>" alt="Build Canada">
  <div class="cover-title">
    <h1><%= e(@title) %></h1>
    <p class="cover-scope"><%= e(survey_scope_label) %></p>
    <p class="cover-date"><%= e(@date) %></p>
  </div>
</section>
<section class="section"><h2><%= @locale == "fr" ? "Méthodologie" : "Methodology" %></h2>
<div class="metadata">
<% if @poll.pollster.present? %><p><%= e(@poll.pollster) %></p><% end %>
<% if @poll.sample_size.present? %><p><%= @locale == "fr" ? "Échantillon" : "Sample" %>: <%= @poll.sample_size %></p><% end %>
<% if @poll.fieldwork_start || @poll.fieldwork_end %><p><%= e([@poll.fieldwork_start, @poll.fieldwork_end].compact.join(" – ")) %></p><% end %>
</div><%= @methodology %></section>
<section class="section analysis">
<% if @takeaways.present? %>
<section class="takeaways"><div class="eyebrow"><%= @locale == "fr" ? "Points à retenir" : "Key takeaways" %></div><ol>
<% @takeaways.each do |item| %><li><%= e(item.is_a?(Hash) ? item["message"] : item) %></li><% end %>
</ol></section>
<% end %>
<main><%= @body %></main>
</section>
<% if @appendix.present? %><section class="section"><h2><%= @locale == "fr" ? "Annexe" : "Appendix" %></h2><%= @appendix %></section><% end %>
</body></html>
