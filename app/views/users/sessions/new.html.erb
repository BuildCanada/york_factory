<div style="max-width: 360px; margin: 4rem auto;">
  <h1 style="text-align: center; margin-bottom: 2rem;">Sign In</h1>

  <% if flash[:alert] %>
    <div class="flash flash-alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="flash flash-notice"><%= flash[:notice] %></div>
  <% end %>

  <%= form_tag(user_session_path, method: :post) do %>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" name="email" id="email" class="form-control" autofocus required>
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" name="password" id="password" class="form-control" required>
    </div>
    <button type="submit" class="btn btn-primary" style="width: 100%;">Sign In</button>
  <% end %>
</div>
