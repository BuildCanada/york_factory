#!/usr/bin/env bash
# Lints the public API spec: Redocly on the split source (structure, examples), Spectral with
# .spectral.yaml on the bundle (Build Canada conventions), then the dictionary check.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tools="$root/docs/openapi"

if [ ! -d "$tools/node_modules" ]; then
  npm ci --prefix "$tools" --no-audit --no-fund >/dev/null
fi

"$root/bin/openapi-bundle" --check
(cd "$tools" && npx --no-install redocly lint --config redocly.yaml public/v1/openapi.yaml)
(cd "$tools" && npx --no-install spectral lint --ruleset ../../.spectral.yaml --fail-severity warn ../../public/v1/openapi.json)
"$root/bin/openapi-check-dictionary"
