# Copy to credentials.yml.enc via: bin/rails credentials:edit
# Never commit the real credentials or config/master.key

secret_key_base:

llm:
  anthropic_api_key:
  gemini_api_key:
  openai_api_key:

search:
  azure_cohere:
    endpoint: https://your-resource.openai.azure.com/openai/v1
    api_key: <azure-ai-api-key>
    model: embed-v-4-0
  turbopuffer:
    api_key: <turbopuffer-api-key>
    production_api_key: <production-turbopuffer-api-key>
    region: gcp-northamerica-northeast2
    namespace: yf-production-documents-v1
  defuddler:
    base_url: https://deffudler.svc.canadasbuilding.com
    api_key: <defuddler-api-key>

discord:
  bot_token:
  client_id:
  client_secret:

github:
  app_id:
  secret:
  webhook_secret:

hubspot:
  access_token:
  portal_id: <hubspot-account-id>
  subscriber_form_guid: <newsletter-form-guid>
  pledge_form_guid: <vote-pledge-form-guid>

luma:
  api_key:

posthog:
  api_key:
  project_id:
  personal_api_key:

twitter:
  client_id:
  client_secret:

twitterapi_io:

webflow:
  api_token:
  build_toronto:
    api_token: <webflow-api-token-for-buildtoronto.com>

kamal:
  registry_username: <github-username>
  registry_password: <github-pat-with-write:packages>

database:
  username: <supabase-db-username>
  password: <supabase-db-password>
  host: <supabase-db-host>
  port: 5432
  database: <supabase-db-name>

r2:
  access_key_id: <cloudflare-r2-key>
  secret_access_key: <cloudflare-r2-secret>
  endpoint: <cloudflare-r2-endpoint>
  bucket: <r2-archival-bucket>
  active_storage_bucket: <r2-active-storage-bucket>

ssl:
  certificate_pem: |
    <cloudflare-origin-certificate-pem>
  private_key_pem: |
    <cloudflare-origin-private-key-pem>

google:
  client_id: <google-oauth-client-id>
  client_secret: <google-oauth-client-secret>
# Read-only API key used by Metrics::ScrapeZernioSocialMediaJob.
zernio:
  api_key: sk_replace_me
