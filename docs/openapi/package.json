{
  "name": "york-factory-openapi",
  "private": true,
  "description": "Lint and bundle tooling for the public data API contract (docs/openapi/public/v1). Run through bin/openapi-bundle and bin/openapi-lint.",
  "scripts": {
    "bundle": "redocly bundle public/v1/openapi.yaml --output dist/v1/openapi.json --ext json",
    "lint:source": "redocly lint --config redocly.yaml public/v1/openapi.yaml",
    "lint:spectral": "spectral lint --ruleset ../../.spectral.yaml --fail-severity warn dist/v1/openapi.json"
  },
  "devDependencies": {
    "@redocly/cli": "2.55.0",
    "@stoplight/spectral-cli": "6.16.3"
  }
}
